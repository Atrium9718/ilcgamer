{
  "name": "ilcgamer",
  "private": true,
  "description": "Plataforma de gamificación y fidelización phygital — Industria Licorera de Caldas",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "tokens": "pnpm --filter @ilc/design-tokens build",
    "storybook": "pnpm --filter @ilc/ui storybook",
    "storybook:build": "turbo run build:storybook",
    "a11y": "node tools/a11y_audit.cjs",
    "dev:api": "pnpm --filter @ilc/api dev",
    "dev:pwa": "pnpm --filter @ilc/pwa dev",
    "dev:console": "pnpm --filter @ilc/console dev",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @ilc/api db:migrate",
    "design:pull": "python3 tools/stitch_pull.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "playwright": "1.63.0",
    "turbo": "2.11.7",
    "typescript": "6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
