{
  "name": "@ilc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de la plataforma phygital ILC (NestJS, monolito modular, /api/v1).",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json && node scripts/copy-guide.mjs",
    "start": "node dist/main.js",
    "dev": "prisma generate && tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/main.js",
    "test": "prisma generate && vitest run",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env dist/seed.js",
    "openapi:export": "node --env-file-if-exists=.env dist/openapi-export.js",
    "admin:grant": "node --env-file-if-exists=.env dist/admin-grant.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@ilc/contracts": "workspace:*",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-fastify": "12.1.1",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "jszip": "3.10.2",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.1",
    "@swc/core": "1.16.2",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "typescript": "6.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  }
}
