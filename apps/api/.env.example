# Copiar a .env (desarrollo local). En staging/producción las variables vienen del gestor de secretos.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ilc:ilc@localhost:5432/ilc_dev
REDIS_URL=redis://localhost:6379
# Orígenes permitidos (CORS + protección CSRF), separados por coma: Vite dev (5173) y vite preview (4173)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Secreto para HMAC de PIN de sesión y hashes de tokens (mín. 32 caracteres). Generar con: openssl rand -hex 32
APP_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Publicar /api/docs (Swagger UI). Desactivado por defecto en producción.
OPENAPI_UI=true
# Límite por IP para control de edad y OTP (por minuto)
AUTH_RATE_LIMIT_PER_MINUTE=10
# Duración de la sesión de acceso (días)
SESSION_TTL_DAYS=30
# Proveedor de códigos OTP: "console" (solo desarrollo: imprime el código en el log) | "none"
OTP_PROVIDER=console
