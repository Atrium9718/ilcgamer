# Copiar a .env (desarrollo local). En staging/producción las variables vienen del gestor de secretos.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ilc:ilc@localhost:5432/ilc_dev
REDIS_URL=redis://localhost:6379
# Orígenes permitidos (CORS + protección CSRF), separados por coma: PWA (5173 dev, 4173 preview) y consola (5174 dev, 4174 preview)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5174,http://localhost:4174
# Secreto para HMAC de PIN de sesión y hashes de tokens (mín. 32 caracteres). Generar con: openssl rand -hex 32
APP_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Publicar /api/docs (Swagger UI). Desactivado por defecto en producción.
OPENAPI_UI=true
# Límite por IP para control de edad y OTP (por minuto)
AUTH_RATE_LIMIT_PER_MINUTE=10
# Duración de la sesión de acceso (días)
SESSION_TTL_DAYS=30
# Proveedor de códigos OTP: "console" (solo desarrollo: imprime el código en el log) | "none"
OTP_PROVIDER=console
# Límite por IP de la consulta pública de códigos y de las reclamaciones (anti-enumeración).
CODE_RATE_LIMIT_PER_MINUTE=30
# Integración ERP (POST /api/v1/smarttags/validate): SHA-256 en hexadecimal de cada clave emitida por TI,
# separadas por coma. Vacío = integración apagada. La clave en claro NUNCA va aquí.
SMARTTAGS_INTEGRATION_KEY_HASHES=
